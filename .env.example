# ─── Required for Google OAuth ───────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# The full callback URL — must match exactly what you put in Google Cloud Console
# Format: https://your-railway-domain.railway.app/auth/google/callback
# Or with custom domain: https://app.truckersdirect.net/auth/google/callback
GOOGLE_CALLBACK_URL=https://app.truckersdirect.net/auth/google/callback

# ─── Session secret — generate a random 32+ char string ──────────────────────
# Use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# ─── Optional: custom data directory for SQLite files ────────────────────────
# Railway persistent volume will be mounted at /data
DATA_DIR=/data

# ─── Node environment ────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000
